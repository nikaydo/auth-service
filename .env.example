# Шаблон конфигурации. Скопируйте его в .env и подставьте реальные значения:
#
#   cp .env.example .env
#
# Приложение проверяет конфигурацию при старте и не запустится, пока
# значения остались заглушками CHANGE_ME.

# ─────────────────────────────────────────────────────────────────────────────
# База данных
# ─────────────────────────────────────────────────────────────────────────────
# Формат: postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/БАЗА?sslmode=disable
DATABASE_URL=CHANGE_ME
MIGRATIONS_DIR=db/migrations

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
# Обязательно замените: openssl rand -base64 48
# Значение короче 32 символов не принимается — короткий ключ проще перебрать.
JWT_SECRET=CHANGE_ME

# Access-токен короткоживущий, refresh-токен — долгоживущий. Refresh хранится
# у клиента в HttpOnly-cookie и при каждом использовании заменяется новым.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
JWT_ISSUER=video-platform

# ─────────────────────────────────────────────────────────────────────────────
# gRPC
# ─────────────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=50051

# Предел размера входящего сообщения в байтах.
MAX_MESSAGE_BYTES=1048576

# ─────────────────────────────────────────────────────────────────────────────
# Хеширование паролей
# ─────────────────────────────────────────────────────────────────────────────
# Стоимость bcrypt. Ниже 10 — слишком быстро для перебора, выше 31 — избыточно
# долго. Значение по умолчанию обычно менять не нужно.
BCRYPT_COST=12