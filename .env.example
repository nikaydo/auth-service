# Скопируйте файл и подставьте свои значения:
#   cp .env.example .env

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=disable

# JWT. Обязательно замените на случайные значения, например:
#   openssl rand -base64 48
SECRET=CHANGE_ME
SECRET_REFRESH=CHANGE_ME
SECRET_TTL=1
REFRESH_TTL=10

# gRPC
HOST=0.0.0.0
PORT=50051
